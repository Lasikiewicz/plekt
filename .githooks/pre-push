#!/bin/sh
set -e

# Only auto-sync for a same-name push (e.g. "alpha" -> "alpha"). A cross-ref
# push (e.g. the "Force to main" force-push of alpha onto main) has already
# been deliberately reconciled by hand, and syncing the current branch
# against an unrelated same-named remote branch would be wrong anyway.
#
# The sync itself merges rather than rebases. alpha's history routinely
# contains a real merge commit (folding a changelog-bump commit from main back
# into alpha), and --rebase walks full ancestry rather than just the
# first-parent chain: it silently drops merge commits and replays both sides'
# commits individually, which can conflict with content the merge already
# resolved. A merge-based pull is a no-op when upstream is already an
# ancestor and a plain merge commit otherwise - never a replay.
# The bug backlog is a hard gate for every remote branch. Check before any sync/pull.
if [ ! -r plan/bugs.md ]; then
  echo 'Cannot verify plan/bugs.md; refusing push.' >&2
  exit 1
fi
if grep -Eq '^[[:space:]]*-[[:space:]]*\[[[:space:]]\]' plan/bugs.md; then
  echo 'plan/bugs.md has unchecked bug/follow-up work; resolve and verify/close it before any remote push.' >&2
  exit 1
fi

develop_push_sha=""

while read -r local_ref local_sha remote_ref remote_sha; do
  local_branch="${local_ref#refs/heads/}"
  remote_branch="${remote_ref#refs/heads/}"
  zero_sha="0000000000000000000000000000000000000000"
  if [ "$local_branch" = "$remote_branch" ] && [ -n "$remote_branch" ] && [ "$remote_sha" != "$zero_sha" ]; then
    echo "Syncing with remote before push..."
    git pull --no-rebase origin "$remote_branch"
  fi
  if [ "$remote_branch" = "develop" ] && [ "$local_sha" != "$zero_sha" ]; then
    develop_push_sha="$local_sha"
  fi
done

if [ -n "$develop_push_sha" ]; then
  # Validate the tree being pushed, rather than the working tree. This blocks
  # a raw push when the local changelog rebuild/commit step was skipped, even
  # if a staged or uncommitted changelog happens to exist locally.
  echo "Checking committed develop changelog..."
  node scripts/rebuild-develop-changelog.js --check "$develop_push_sha"

  # More than one pending product commit means the changelog will fold several
  # subjects into one run-on headline. push-to-git step 7 consolidates; this
  # refuses the push when that step was skipped.
  echo "Checking pending commit shape..."
  node scripts/check-pending-commits.js "origin/develop..$develop_push_sha"
fi

echo "Running Plekt pre-push build check..."
npm run build
