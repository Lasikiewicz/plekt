{
  "name": "plekt",
  "version": "2.2.2",
  "private": true,
  "type": "module",
  "main": "server/server.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "node scripts/start-local.js",
    "dev": "node --watch-path=server scripts/start-local.js",
    "test": "node scripts/run-tests.js",
    "test:multiprocess": "node --test test/multiprocess.test.js",
    "build": "node scripts/build-check.js",
    "docs:check": "node scripts/docs-check.js",
    "code-index": "node scripts/generate-code-index.js",
    "todo:check": "node scripts/check-todo.mjs",
    "assets:check": "node scripts/asset-versions.js",
    "assets:update": "node scripts/asset-versions.js --write",
    "demo:assets": "node scripts/build-demo-assets.js",
    "demo:seed": "node scripts/seed-demo-catalog.js",
    "demo:verify": "node scripts/verify-oracle-demo.js",
    "seed:demo": "node scripts/seed-demo-content.js",
    "updates:refresh": "node scripts/update-local-updates.js",
    "server:restart": "node scripts/restart-server.js",
    "check:website-impact": "node scripts/site-impact.js",
    "prepare": "node scripts/install-git-hooks.js",
    "push:prepare": "node scripts/prepare-push.js",
    "push:precheck": "node scripts/workflow-check.js precheck push",
    "alpha:precheck": "node scripts/workflow-check.js precheck alpha",
    "release:precheck": "node scripts/workflow-check.js precheck main",
    "release:candidate": "node scripts/workflow-check.js candidate",
    "release:reconcile": "node scripts/workflow-check.js reconcile",
    "release:verify-live": "node scripts/verify-release-website.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.1",
    "busboy": "^1.6.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.0",
    "fast-xml-parser": "5.11.2",
    "morgan": "^1.12.0",
    "rotating-file-stream": "^3.2.9",
    "sharp": "^0.35.5",
    "undici": "^8.12.3"
  },
  "overrides": {
    "proxy-addr": "^2.0.8"
  }
}
