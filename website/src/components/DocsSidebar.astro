---
import { docsSidebarNav, site } from "../data/site.js";

type DocsSidebarItem = {
  id?: string;
  slug: string;
  label: string;
  children?: DocsSidebarItem[];
};

const { currentSlug = "" } = Astro.props;
const isDocsHome = Astro.url.pathname === "/docs/";
const isCurrentPage = (slug = "") => slug === currentSlug;
const hasCurrentChild = (item: DocsSidebarItem) => (item.children || []).some((child: DocsSidebarItem) => isCurrentPage(child.slug));
---

<aside class="docs-sidebar" data-doc-sidebar data-doc-current-slug={currentSlug} aria-label="Documentation navigation">
  <a
    class:list={{ active: isDocsHome }}
    class="docs-sidebar-home"
    href="/docs/"
    aria-current={isDocsHome ? "page" : undefined}
  >Docs Home</a>

  <nav class="docs-nav-pages" aria-label="Documentation pages">
    {(docsSidebarNav as DocsSidebarItem[]).map((item, index) => {
      const children: DocsSidebarItem[] = item.children || [];
      const isCurrent = isCurrentPage(item.slug);
      const isBranchCurrent = isCurrent || hasCurrentChild(item);
      const subnavId = `docs-nav-subnav-${item.id || index}`;

      return (
        <section
          class:list={{ "docs-nav-section--has-children": children.length > 0, "docs-nav-section--current": isBranchCurrent }}
          class="docs-nav-section"
          data-doc-nav-section
          data-doc-open={isBranchCurrent ? "true" : "false"}
        >
          <h2 class="docs-nav-heading">
            {item.slug ? (
              <a
                class:list={{ active: isCurrent }}
                class="docs-nav-parent"
                href={`/docs/${item.slug}/`}
                aria-current={isCurrent ? "page" : undefined}
              >
                {item.label}
              </a>
            ) : (
              <span class="docs-nav-parent docs-nav-label">{item.label}</span>
            )}
            {children.length > 0 && (
              <button
                type="button"
                class="docs-nav-toggle"
                data-doc-nav-toggle
                aria-controls={subnavId}
                aria-expanded={isBranchCurrent ? "true" : "false"}
                aria-label={`${isBranchCurrent ? "Collapse" : "Expand"} ${item.label}`}
              >
                <span aria-hidden="true">⌄</span>
              </button>
            )}
          </h2>

          {children.length > 0 && (
            <nav
              id={subnavId}
              class="docs-nav-subnav"
              aria-label={`${item.label} documentation`}
              hidden={!isBranchCurrent}
            >
              {children.map((child: DocsSidebarItem) => {
                const childIsCurrent = isCurrentPage(child.slug);
                return (
                  <a
                    class:list={{ active: childIsCurrent }}
                    class="docs-nav-child"
                    href={`/docs/${child.slug}/`}
                    aria-current={childIsCurrent ? "page" : undefined}
                  >
                    {child.label}
                  </a>
                );
              })}
            </nav>
          )}
        </section>
      );
    })}
  </nav>
  <a class="docs-source-link button-secondary" href={site.repositoryDocs} target="_blank" rel="noreferrer">Technical source docs</a>
</aside>

<script>
  document.querySelectorAll("[data-doc-nav-toggle]").forEach((toggle) => {
    toggle.addEventListener("click", () => {
      const section = toggle.closest("[data-doc-nav-section]");
      const subnav = document.getElementById(toggle.getAttribute("aria-controls") || "");
      if (!(section instanceof HTMLElement) || !(subnav instanceof HTMLElement)) return;

      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      const nextOpen = !isOpen;
      toggle.setAttribute("aria-expanded", String(nextOpen));
      toggle.setAttribute("aria-label", `${nextOpen ? "Collapse" : "Expand"} ${section.querySelector(".docs-nav-parent")?.textContent?.trim() || "section"}`);
      section.dataset.docOpen = String(nextOpen);
      subnav.hidden = !nextOpen;
    });
  });
</script>
