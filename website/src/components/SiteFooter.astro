---
import { site } from "../data/site.js";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer-inner">
    <div>
      <a class="footer-brand" href="/">Plekt</a>
      <p>The local brain for your media stack.</p>
    </div>
    <div class="footer-links">
      <a href="/features/">Features</a>
      <a href="/docs/">Documentation</a>
      <a href="/changelog/">Changelog</a>
      <a href={site.repository} target="_blank" rel="noreferrer">GitHub</a>
      <a href="/support/">Support Plekt</a>
      <a href={site.discord} target="_blank" rel="noreferrer">Discord</a>
      <a href={site.reddit} target="_blank" rel="noreferrer">Reddit</a>
    </div>
    <div class="footer-meta">
      <span>AGPL-3.0</span>
      <span>© {year} Plekt</span>
    </div>
  </div>
  <div class="site-footer-attribution">
    Artwork and metadata can come from TMDB, TheTVDB, Fanart.tv, OMDb, and YouTube. Plekt is not endorsed or certified by those services.
  </div>
</footer>
