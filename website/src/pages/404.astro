---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="Page not found" noindex>
  <section class="section" style="min-height: 60vh;">
    <div class="section-header">
      <div><span class="section-index">404</span><h1>That page is not in the archive.</h1></div>
      <p>Try the documentation home or return to Plekt's product overview.</p>
    </div>
    <div class="button-row" style="margin-top: var(--space-7);">
      <a class="button-primary" href="/docs/">Open documentation</a>
      <a class="button-secondary" href="/">Return home</a>
    </div>
  </section>
</SiteLayout>
