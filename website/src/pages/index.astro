---
import SiteLayout from "../layouts/SiteLayout.astro";
import ScreenshotFigure from "../components/ScreenshotFigure.astro";
import { integrations } from "../data/site.js";
import release from "../generated/release.json";

const syncServices = integrations.slice(0, 4);
const demoUrl = "https://demo.plekt.net/";

const loopSteps = [
  {
    number: "01",
    title: "Track",
    text: "Plays, pauses, and stops arrive by webhook and polling from your media servers.",
    href: "/docs/concepts/#the-event-lifecycle",
  },
  {
    number: "02",
    title: "Remember",
    text: "Each watch is recorded once, locally, with its date, source, and progress.",
    href: "/docs/concepts/#the-canonical-record",
  },
  {
    number: "03",
    title: "Auto-sync",
    text: "Watched state and resume position go back out to every other connected service.",
    href: "/docs/concepts/#watched-state-and-resume-progress",
  },
  {
    number: "04",
    title: "Restore",
    text: "Add media or rebuild a library and the local record is replayed onto it.",
    href: "/docs/sync-tools/#full-sync-watchstates",
  },
];

const appAreas = [
  {
    number: "01",
    title: "Up Next",
    text: "One mixed queue for movie and episode resume progress, plus released next-up.",
    href: "/docs/dashboard/#up-next",
  },
  {
    number: "02",
    title: "Movies and TV detail pages",
    text: "Cast, trailers, artwork, reviews, and episode air dates on every title.",
    href: "/docs/media-details/#what-the-page-can-contain",
  },
  {
    number: "03",
    title: "Discover and request",
    text: "Browse current rails, then request what you are missing through Seerr.",
    href: "/docs/discover/#discovery-rails",
  },
  {
    number: "04",
    title: "Stats and history",
    text: "All-time and period reports on what you actually watched, and where.",
    href: "/docs/stats/#reported-totals",
  },
];

const comparisonApps = [
  { name: "Plekt", href: "https://github.com/Lasikiewicz/plekt", plekt: true },
  { name: "Yamtrack", href: "https://github.com/rpmalouin/yamtrack" },
  { name: "Floppy", href: "https://github.com/dannyvfilms/Floppy" },
  { name: "PlexTraktSync", href: "https://github.com/Taxel/PlexTraktSync" },
  { name: "WatchState", href: "https://github.com/arabcoders/watchstate" },
  { name: "CrossWatch", href: "https://github.com/cenodude/CrossWatch" },
  { name: "JellyPlex-Watched", href: "https://github.com/luigi311/JellyPlex-Watched" },
];

const comparisonFeatures = [
  { name: "Self-hosted", supported: [true, true, true, true, true, true, true] },
  { name: "Connects to Plex", supported: [true, true, true, true, true, true, true] },
  { name: "Connects to Emby", supported: [true, true, true, false, true, true, true] },
  { name: "Connects to Jellyfin", supported: [true, true, true, false, true, true, true] },
  { name: "Syncs watch state across media servers", supported: [true, false, false, false, true, true, true] },
  { name: "Syncs resume progress across media servers", supported: [true, false, false, false, true, false, true] },
  { name: "Connects to or imports from Trakt", supported: [true, true, true, true, false, true, false] },
  { name: "Tracks books, games, or other media", supported: [false, true, true, false, false, false, false] },
  { name: "Includes personal history or stats", supported: [true, true, true, false, false, true, false] },
  { name: "Keeps a canonical archive and restores watch state to rebuilt libraries", supported: [true, false, false, false, false, false, false] },
];
---

<SiteLayout
  title="The local brain for your media stack."
  description="Keep Plex, Emby, and Jellyfin in sync from one private watch-history archive. Plekt preserves watched status, playback progress, and rewatches, ready to restore after a library rebuild."
  image="/assets/home-dashboard.jpg"
>
  <div class="simple-home">
    <div class="modern-home-intro">
    <section class="simple-home-hero" aria-labelledby="home-title">
      <p class="simple-eyebrow">SELF-HOSTED WATCH HISTORY</p>
        <div class="simple-home-title">
          <img
            class="simple-home-logo"
            data-theme-image
            data-dark-src="/assets/optimized/plembfin_header_logo_dark-376.webp"
            data-light-src="/assets/optimized/plembfin_header_logo_light-376.webp"
            src="/assets/optimized/plembfin_header_logo_dark-376.webp"
            alt="Plekt"
            width="376"
            height="61"
          />
          <h1 id="home-title">The local brain for your<br /><span>media stack.</span></h1>
        </div>
        <p class="simple-home-lede">
        Keep Plex, Emby, and Jellyfin in sync from one private watch-history archive. Plekt preserves watched status, playback progress, and rewatches, ready to restore after a library rebuild.
        </p>
      <div class="simple-actions">
        <a class="simple-button simple-button--primary" href="/docs/getting-started/">Get started <span aria-hidden="true">↗</span></a>
        <a class="simple-button" href="/features/">View features <span aria-hidden="true">→</span></a>
        <a class="simple-button simple-button--demo" href={demoUrl} target="_blank" rel="noopener noreferrer">Try the demo <span aria-hidden="true">↗</span></a>
      </div>
      <p class="simple-demo-note">
        Public demo login: <code>demo</code> / <code>demo</code> · actions are simulated and nothing is saved.
      </p>
      <p class="simple-meta">v{release.version} · one process · one SQLite file · your hardware</p>
    </section>

    <section class="simple-home-preview" aria-labelledby="preview-title">
      <div class="simple-section-heading">
        <div>
          <p class="simple-eyebrow">THE DASHBOARD</p>
          <h2 id="preview-title">Your whole media stack, at a glance.</h2>
        </div>
        <p>See what is playing, what is next, and what you watched across Plex, Emby, and Jellyfin, all in one private dashboard.</p>
        <a class="simple-text-link" href="/docs/dashboard/">Explore the dashboard <span aria-hidden="true">→</span></a>
      </div>
      <ScreenshotFigure
        src="/assets/home-dashboard.jpg"
        darkSrc="/assets/home-dashboard-dark.jpg"
        alt="Plekt dashboard showing an Up Next row and recent watch history for TV and movies"
        loading="eager"
        fetchpriority="high"
        width={2000}
        height={998}
      />
    </section>
    </div>

    <section class="simple-home-comparison" aria-labelledby="comparison-title">
      <div class="simple-section-heading">
        <div>
          <p class="simple-eyebrow">PICK THE RIGHT FIT</p>
          <h2 id="comparison-title">How does Plekt compare?</h2>
        </div>
        <p>Different tools solve different parts of media tracking and sync.</p>
      </div>

      <div class="simple-home-comparison-wrap" tabindex="0" role="region" aria-label="Feature comparison table. Scroll horizontally to see every app.">
        <table class="simple-home-comparison-table">
          <thead>
            <tr>
              <th scope="col">Capability</th>
              {comparisonApps.map((app) => (
                <th scope="col" class:list={{ "is-plekt": app.plekt }}>
                  <a href={app.href} target="_blank" rel="noopener noreferrer">{app.name}</a>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {comparisonFeatures.map((feature) => (
              <tr>
                <th scope="row">{feature.name}</th>
                {feature.supported.map((supported, index) => (
                  <td class:list={{ "is-plekt": index === 0 }}>
                    {supported && <span class="comparison-check" aria-label="Yes">✓</span>}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="simple-home-comparison-note">Plekt keeps one restorable watch history in sync across your servers. Ticks mark each app’s documented core capabilities.</p>
    </section>

    <section class="simple-home-up-next" aria-labelledby="up-next-home-title">
      <div class="simple-section-heading">
        <div>
          <p class="simple-eyebrow">UP NEXT</p>
          <h2 id="up-next-home-title">Pick up right where you left off.</h2>
        </div>
        <p>Bring in-progress films and episodes from your servers into one queue. Check resume progress, jump to the right player, or restore anything you dismissed.</p>
        <a class="simple-text-link" href="/docs/dashboard/#up-next">Explore the Up Next queue <span aria-hidden="true">→</span></a>
      </div>
      <ScreenshotFigure
        darkSrc="/assets/app-captures/dashboard-up-next-dark.png"
        lightSrc="/assets/app-captures/dashboard-up-next-light.png"
        alt="Plekt Up Next queue showing movie and TV continuation cards with real resume context and provider Watch now links"
        loading="lazy"
        width={1232}
        height={167}
      />
    </section>

    <section class="simple-home-playlists" aria-labelledby="playlists-home-title">
      <div class="simple-section-heading">
        <div>
          <p class="simple-eyebrow">PLAYLISTS</p>
          <h2 id="playlists-home-title">One playlist. Every server.</h2>
        </div>
        <p>Create hand-picked playlists or set rules to build them for you. Plekt keeps them in sync across Plex, Emby, and Jellyfin, with automatic playlists refreshing hourly.</p>
        <a class="simple-text-link" href="/docs/playlists/">Explore playlists <span aria-hidden="true">→</span></a>
      </div>
      <ScreenshotFigure
        darkSrc="/assets/app-captures/playlists-dark.png"
        lightSrc="/assets/app-captures/playlists-light.png"
        alt="Plekt Playlists page with automatic and hand-picked playlists, each showing its type, synced apps, and item count"
        loading="lazy"
        width={1440}
        height={683}
      />
    </section>

    <section class="simple-home-flow" aria-labelledby="flow-title">
      <div class="simple-section-heading">
        <div>
          <p class="simple-eyebrow">THE LOOP</p>
          <h2 id="flow-title">Track it. Remember it. Sync it back.</h2>
        </div>
        <p>Every play is tracked, saved, and synced.</p>
      </div>

      <div class="simple-flow-list">
        {loopSteps.map((step) => (
          <a href={step.href}>
            <span class="simple-number">{step.number}</span>
            <span><strong>{step.title}</strong><small>{step.text}</small></span>
            <span class="simple-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>

      <div class="simple-section-heading-note">
        <p>Your watch history survives library rebuilds, server moves, and outages. Local and remote backups keep it protected.</p>
        <div class="simple-backup-links" aria-label="Backup documentation">
          <a class="simple-text-link" href="/docs/settings/backup/#local-backups">Local backups <span aria-hidden="true">→</span></a>
          <a class="simple-text-link" href="/docs/settings/backup/#remote-backups">Remote backups <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section class="simple-home-app" aria-labelledby="app-title">
      <div class="simple-section-heading">
        <div>
          <p class="simple-eyebrow">MORE THAN SYNC</p>
          <h2 id="app-title">It is also the app you browse.</h2>
        </div>
        <p>Posters, cast, air dates, and viewing stats.</p>
      </div>

      <div class="simple-feature-grid">
        {appAreas.map((area) => (
          <a class="simple-feature-item" href={area.href}>
            <span class="simple-number">{area.number}</span>
            <span><strong>{area.title}</strong><small>{area.text}</small></span>
            <span class="simple-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>

    <section class="simple-home-hub" aria-labelledby="stack-title">
      <div class="simple-home-hub-copy">
        <p class="simple-eyebrow">BUILT AROUND YOUR STACK</p>
        <h2 id="stack-title">Everything talks to Plekt.</h2>
        <p>Watch state syncs across your servers and Trakt. Metadata and request tools connect through Plekt.</p>
        <div class="simple-service-list" aria-label="Watch-state services">
          {syncServices.map((service) => (
            <span><img src={service.icon} alt="" aria-hidden="true" width="20" height="20" />{service.name}</span>
          ))}
        </div>
        <a class="simple-text-link" href="/features/">See all features <span aria-hidden="true">→</span></a>
      </div>
      <ScreenshotFigure
        src="/assets/optimized/plembfin-hub.svg"
        lightboxSrc="/assets/optimized/plembfin-hub.svg"
        alt="Diagram connecting Plekt to Plex, Emby, Jellyfin, and Trakt for two-way watch state, and to TMDB, TheTVDB, Fanart.tv, OMDb, and Seerr for metadata and requests"
        width={1200}
        height={540}
        loading="lazy"
      />
    </section>
  </div>
</SiteLayout>
