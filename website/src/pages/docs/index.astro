---
import { getCollection, type CollectionEntry } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import DocsSidebar from "../../components/DocsSidebar.astro";
import ScreenshotFigure from "../../components/ScreenshotFigure.astro";
import { docsNav } from "../../data/site.js";

const entries = await getCollection("docs");
type DocEntry = CollectionEntry<"docs">;
const getEntrySlug = (entry: DocEntry) => entry.id.replace(/\.(?:md|mdx)$/i, "");
const docsBySlug = new Map(entries.map((entry) => [getEntrySlug(entry), entry]));
type HeadingInfo = { level: number; text: string };
type NavChild = { id: string; label: string; children?: NavChild[] };
type NavItem = { slug: string; label: string; description: string; children?: NavChild[] };
type NavSection = { label: string; items: NavItem[] };
type SectionScreenshot = { darkSrc: string; lightSrc: string; alt: string; caption: string };
type SearchPage = { slug: string; label: string; body: string };
type SectionSearchEntry = NavChild & {
  section: string;
  body: string;
  excerpt: string;
  screenshot: SectionScreenshot | null;
  headingPath: string[];
  href: string;
  kind: "section";
  pageLabel: string;
  pageSlug: string;
};

const stripSearchMarkup = (value: unknown) => String(value || "")
  .replace(/<[^>]+>/g, " ")
  .replace(/!\[[^\]]*\]\([^)]*\)/g, " ")
  .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
  .replace(/[\\*_`>#-]/g, " ")
  .replace(/\s+/g, " ")
  .trim();
const headingFromLine = (line: string): HeadingInfo | null => {
  const normalizedLine = line.trim();
  const markdownHeading = normalizedLine.match(/^(#{2,6})\s+(.+?)\s*#*\s*$/);
  if (markdownHeading) return { level: markdownHeading[1].length, text: markdownHeading[2] };
  const htmlHeading = normalizedLine.match(/^<h([2-6])(?:\s+[^>]*)?>(.*?)<\/h\1>$/i);
  if (htmlHeading) return { level: Number(htmlHeading[1]), text: htmlHeading[2] };
  return null;
};
const headingSlug = (value: unknown) => stripSearchMarkup(value).toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
const truncateSearchText = (value: unknown, limit = 420) => {
  const text = stripSearchMarkup(value);
  if (text.length <= limit) return text;
  return `${text.slice(0, limit).replace(/\s+\S*$/, "")}…`;
};
const readAttribute = (attributes: string, name: string) => attributes.match(new RegExp(`${name}="([^"]+)"`, "i"))?.[1] || "";
const extractSectionScreenshot = (body: unknown): SectionScreenshot | null => {
  const match = String(body || "").match(/<ScreenshotFigure\b([\s\S]*?)\/>/i);
  if (!match) return null;

  const attributes = match[1];
  const src = readAttribute(attributes, "src");
  const darkSrc = readAttribute(attributes, "darkSrc") || src;
  const lightSrc = readAttribute(attributes, "lightSrc") || src;
  if (!darkSrc && !lightSrc) return null;

  return {
    darkSrc,
    lightSrc,
    alt: readAttribute(attributes, "alt") || "Plekt documentation screenshot",
    caption: readAttribute(attributes, "caption"),
  };
};
const extractSectionBody = (body: unknown, id: string) => {
  const lines = String(body || "").split(/\r?\n/);
  const start = lines.findIndex((line) => {
    const heading = headingFromLine(line);
    return heading && (headingSlug(heading.text) === id || line.includes(`id="${id}"`));
  });
  if (start < 0) return "";

  const startHeading = headingFromLine(lines[start]);
  const end = lines.findIndex((line, index) => {
    if (index <= start) return false;
    const heading = headingFromLine(line);
    return heading && startHeading && heading.level <= startHeading.level;
  });
  return lines.slice(start + 1, end < 0 ? lines.length : end).join(" ");
};
const collectSectionEntries = (children: NavChild[], page: SearchPage, section: string, parentHeadings: string[] = []): SectionSearchEntry[] => children.flatMap((child) => {
  const sectionBody = extractSectionBody(page.body, child.id);
  const headingPath = [...parentHeadings, child.label];
  return [
    {
      ...child,
      section,
      body: sectionBody,
      excerpt: truncateSearchText(sectionBody),
      screenshot: extractSectionScreenshot(sectionBody),
      headingPath,
      href: `/docs/${page.slug}/#${child.id}`,
      kind: "section",
      pageLabel: page.label,
      pageSlug: page.slug,
    },
    ...collectSectionEntries(child.children || [], page, section, headingPath),
  ];
});
const docsSearchEntries = (docsNav as NavSection[]).flatMap((section) => section.items.flatMap((item) => {
  const entry = docsBySlug.get(item.slug);
  if (!entry) return [];

  const page = {
    ...item,
    section: section.label,
    body: entry.body ?? "",
    excerpt: item.description,
    screenshot: null,
    headingPath: [item.label],
    href: `/docs/${item.slug}/`,
    kind: "guide",
    pageLabel: item.label,
    pageSlug: item.slug,
  };

  return [page, ...collectSectionEntries(item.children || [], page, section.label)];
}));
---

<SiteLayout title="Documentation" description="Practical guides for installing, connecting, using, and maintaining Plekt.">
  <div class="docs-shell">
    <DocsSidebar />
    <div class="docs-main">
      <header class="docs-intro">
        <div>
          <h1>Documentation</h1>
          <p>Practical guides for installing Plekt, understanding the sync model, using each page, and keeping your archive safe.</p>
        </div>
      </header>

      <section class="docs-search-results" id="docs-search-results" aria-live="polite" hidden>
        <p class="docs-search-results-status" id="docs-search-status" aria-live="polite"></p>
        <div class="docs-search-results-list article-body">
          {docsSearchEntries.map((item) => {
            const primaryHeading = item.headingPath[0];
            const secondaryHeading = item.headingPath[1];
            const tertiaryHeading = item.headingPath[2];
            const leafIndex = item.headingPath.length - 1;
            return (
            <article
              class="docs-global-search-result"
              data-doc-search-result
              data-search-kind={item.kind}
              data-search-label={item.label}
              data-search-headings={item.headingPath.join(" ")}
              data-search-path={item.headingPath.map(headingSlug).join("|")}
              data-search-page={item.pageSlug}
              data-search-text={`${item.headingPath.join(" ")} ${item.pageLabel} ${item.section} ${item.body}`}
            >
              <p class="docs-global-search-result-source">{item.kind === "section" ? item.pageLabel : item.section}</p>
              {primaryHeading && <h2>{leafIndex === 0 ? <a href={item.href}>{primaryHeading}</a> : primaryHeading}</h2>}
              {secondaryHeading && <h3>{leafIndex === 1 ? <a href={item.href}>{secondaryHeading}</a> : secondaryHeading}</h3>}
              {tertiaryHeading && <h4><a href={item.href}>{tertiaryHeading}</a></h4>}
              {item.screenshot && (
                <ScreenshotFigure
                  darkSrc={item.screenshot.darkSrc}
                  lightSrc={item.screenshot.lightSrc}
                  alt={item.screenshot.alt}
                  caption={item.screenshot.caption}
                />
              )}
              {item.excerpt && <p>{item.excerpt}</p>}
            </article>
            );
          })}
        </div>
        <p class="docs-search-empty" id="docs-search-empty" hidden>No documentation matches that search.</p>
      </section>

      <section class="docs-category" data-doc-search-category data-search-text="start here installation setup first run">
        <h2>Start here</h2>
        <div class="docs-card-grid">
          {docsNav[0].items.map((item) => {
            const entry = docsBySlug.get(item.slug);
            return entry && <a class="docs-card" href={`/docs/${item.slug}/`} data-doc-search-card data-search-text={`${item.label} ${item.description} ${entry.body}`}>
              <h3>{item.label}</h3><p>{item.description}</p>
            </a>;
          })}
        </div>
      </section>

      {docsNav.slice(1).map((section) => (
        <section class="docs-category" data-doc-search-category data-search-text={`${section.label} ${section.items.map((item) => `${item.label} ${item.description}`).join(" ")}`}>
          <h2>{section.label}</h2>
          <div class="docs-card-grid">
            {section.items.map((item) => {
              const entry = docsBySlug.get(item.slug);
              return entry && <a class="docs-card" href={`/docs/${item.slug}/`} data-doc-search-card data-search-text={`${item.label} ${item.description} ${entry.body}`}>
                <h3>{item.label}</h3><p>{item.description}</p>
              </a>;
            })}
          </div>
        </section>
      ))}

    </div>
  </div>
</SiteLayout>

<script>
  const input = document.querySelector<HTMLInputElement>("#docs-search-input");
  const clearButton = document.querySelector<HTMLButtonElement>("#docs-search-clear");
  const status = document.querySelector<HTMLElement>("#docs-search-status");
  const categories = [...document.querySelectorAll<HTMLElement>("[data-doc-search-category]")];
  const resultsPanel = document.querySelector<HTMLElement>("#docs-search-results");
  const resultList = document.querySelector<HTMLElement>(".docs-search-results-list");
  const resultItems = [...document.querySelectorAll<HTMLElement>("[data-doc-search-result]")];
  const emptyState = document.querySelector<HTMLElement>("#docs-search-empty");
  const resultOrder = new Map(resultItems.map((item, index) => [item, index]));
  const normalizeSearchText = (value: string) => value.toLowerCase().replace(/[^a-z0-9]+/g, " ").trim();
  const escapeRegExp = (value: string) => value.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");

  if (input && !input.value) {
    const query = new URL(window.location.href).searchParams.get("q") || "";
    if (query) input.value = query;
  }

  const clearHighlights = () => {
    resultList?.querySelectorAll("mark[data-doc-search-highlight]").forEach((mark) => {
      mark.replaceWith(document.createTextNode(mark.textContent || ""));
    });
  };

  const highlightMatches = (query: string) => {
    clearHighlights();
    if (!query || !resultList) return;

    const terms = query.split(" ").filter(Boolean);
    const matcher = new RegExp(`(${terms.map(escapeRegExp).join("|")})`, "gi");
    const walker = document.createTreeWalker(resultList, NodeFilter.SHOW_TEXT);
    const textNodes: Text[] = [];
    let node = walker.nextNode();

    while (node) {
      const parent = node.parentElement;
      if (node instanceof Text && parent && !parent.closest("pre, code, script, style, mark, [hidden]")) textNodes.push(node);
      node = walker.nextNode();
    }

    textNodes.forEach((textNode) => {
      const value = textNode.nodeValue || "";
      if (!matcher.test(value)) {
        matcher.lastIndex = 0;
        return;
      }
      matcher.lastIndex = 0;

      const fragment = document.createDocumentFragment();
      value.split(matcher).forEach((part) => {
        if (terms.some((term) => part.toLowerCase() === term)) {
          const mark = document.createElement("mark");
          mark.dataset.docSearchHighlight = "true";
          mark.textContent = part;
          fragment.append(mark);
        } else {
          fragment.append(document.createTextNode(part));
        }
      });
      textNode.parentNode?.replaceChild(fragment, textNode);
    });
  };

  const scoreSearchResult = (item: HTMLElement, query: string) => {
    const label = normalizeSearchText(item.getAttribute("data-search-label") || "");
    const headings = normalizeSearchText(item.getAttribute("data-search-headings") || "");
    const text = normalizeSearchText(item.getAttribute("data-search-text") || "");
    const kind = item.getAttribute("data-search-kind");
    let score = 0;

    // A section title is the useful destination. Keep exact and title-level
    // matches ahead of incidental mentions in a guide's body text.
    if (label === query) score += 100000;
    else if (label.startsWith(query)) score += 10000;
    else if (label.includes(query)) score += 5000;
    else if (headings.includes(query)) score += 2500;
    if (kind === "section") score += 1000;

    if (text.includes(query)) score += 150;
    return score;
  };

  const renderSearch = () => {
    if (!input) return;
    const query = normalizeSearchText(input.value);
    clearHighlights();

    if (!query) {
      categories.forEach((category) => { category.hidden = false; });
      if (resultsPanel) resultsPanel.hidden = true;
      if (status) status.textContent = "";
      if (clearButton) clearButton.hidden = true;
      return;
    }

    categories.forEach((category) => { category.hidden = true; });
    if (resultsPanel) resultsPanel.hidden = false;
    if (clearButton) clearButton.hidden = false;

    const candidateItems = resultItems.filter((item) => {
      const searchableText = normalizeSearchText(item.getAttribute("data-search-text") || "");
      const headings = normalizeSearchText(item.getAttribute("data-search-headings") || "");
      const kind = item.getAttribute("data-search-kind");
      return kind === "guide" ? headings.includes(query) : searchableText.includes(query);
    });

    const matchingItems = candidateItems.filter((item) => {
      if (item.getAttribute("data-search-kind") !== "section") return true;

      const headings = normalizeSearchText(item.getAttribute("data-search-headings") || "");
      if (headings.includes(query)) return true;

      const page = item.getAttribute("data-search-page");
      const path = item.getAttribute("data-search-path") || "";
      return !candidateItems.some((candidate) => {
        if (candidate === item || candidate.getAttribute("data-search-kind") !== "section") return false;
        if (candidate.getAttribute("data-search-page") !== page) return false;
        const candidatePath = candidate.getAttribute("data-search-path") || "";
        const candidateHeadings = normalizeSearchText(candidate.getAttribute("data-search-headings") || "");
        return candidatePath.startsWith(`${path}|`) && candidateHeadings.includes(query);
      });
    });

    resultItems.forEach((item) => {
      item.hidden = !matchingItems.includes(item);
    });

    matchingItems.sort((first, second) => {
      const scoreDifference = scoreSearchResult(second, query) - scoreSearchResult(first, query);
      return scoreDifference || (resultOrder.get(first) ?? 0) - (resultOrder.get(second) ?? 0);
    });
    matchingItems.forEach((item) => resultList?.append(item));

    const visible = matchingItems.length;

    if (resultList) resultList.hidden = visible === 0;
    if (emptyState) emptyState.hidden = visible !== 0;
    if (status) status.textContent = `${visible} global result${visible === 1 ? "" : "s"}`;
    highlightMatches(query);
  };

  input?.addEventListener("input", renderSearch);
  clearButton?.addEventListener("click", () => {
    if (!input) return;
    input.value = "";
    renderSearch();
    input.focus();
  });

  window.addEventListener("docs-global-search-clear", renderSearch);
  renderSearch();
</script>
